# =======================================================
# CONFIGURACIÓN DE ENTORNO - PUBLIENTIS BACKEND (.env.example)
# =======================================================

NODE_ENV=development
PORT=8070

# Base de datos (MongoDB Atlas)
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/publientis?retryWrites=true&w=majority

# Autenticación y Cifrado
JWT_SECRET_KEY=tu_jwt_secret_key_muy_seguro
JWT_EXPIRES_IN=7d
SESSION_SECRET=tu_session_secret_para_express_session
ENCRYPTION_KEY=clave_cifrado_32_bytes_hexadecimal
SENSITIVE_DATA_KEY=clave_datos_sensibles_32_bytes_hex

# URLs y Dominios
FRONTEND_URL=http://localhost:3000
FRONTEND_DOMAIN=publientis.online
BACKEND_DOMAIN=api.publientis.online

# Google OAuth2 y Gmail API
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_google_client_secret
CLIENT_ID=tu_gmail_client_id
CLIENT_SECRET=tu_gmail_client_secret
REDIRECT_URI=https://publientis.online/api/auth/google/callback
REFRESH_TOKEN=tu_gmail_refresh_token
EMAIL_FROM=no-reply@publientis.online

# Facebook OAuth
FACEBOOK_APP_ID=tu_facebook_app_id
FACEBOOK_APP_SECRET=tu_facebook_app_secret

# Cloudinary (Almacenamiento de fotos de perfil y portafolios)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_cloudinary_api_key
CLOUDINARY_API_SECRET=tu_cloudinary_api_secret

# =======================================================
# MICROSERVICIO DE VERIFICACIÓN FACIAL (Face Recognition Engine)
# =======================================================
VERIFIER_API_URL=https://verify.publientis.online
VERIFIER_API_KEY=tu_verifier_api_key_secreta_aqui